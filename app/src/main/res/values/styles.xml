<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Gallery.PopupMenu</item>
        <item name="dropdownListPreferredItemHeight">@dimen/expressive_menu_item_height</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="FullScreenTheme.Base" parent="AppTheme">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="FullScreenTheme" parent="FullScreenTheme.Base" />

    <style name="AppTheme.ActionBar.TitleTextStyle">
        <item name="android:textSize">@dimen/extra_big_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Gallery.PopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- overrides commons: rounded tonal popup for the dynamic (Material You) themes -->
    <style name="TopPopupMenuYou" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_expressive</item>
        <item name="android:dropDownHorizontalOffset">-8dp</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="TopPopupMenuTextYou">
        <item name="android:textColor">@color/you_neutral_text_color</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Gallery.PopupMenu</item>
        <item name="dropdownListPreferredItemHeight">@dimen/expressive_menu_item_height</item>
    </style>

    <style name="ThemeOverlay.Gallery.DarkPopup" parent="">
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Gallery.PopupMenu.Dark</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Gallery.PopupMenu</item>
        <item name="dropdownListPreferredItemHeight">@dimen/expressive_menu_item_height</item>
    </style>

    <style name="Widget.Gallery.PopupMenu.Dark" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_dark</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="ThemeOverlay.Gallery.LightPopup" parent="">
        <item name="android:textColor">#FF1A1C2C</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Gallery.PopupMenu.Light</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Gallery.PopupMenu</item>
        <item name="dropdownListPreferredItemHeight">@dimen/expressive_menu_item_height</item>
    </style>

    <style name="Widget.Gallery.PopupMenu.Light" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_light</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>
